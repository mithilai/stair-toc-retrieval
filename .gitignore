# Source books — large, expensive to move, and licence-restricted.
# The folder's README is tracked; not one byte of the books is.
books_AI/*
!books_AI/README.md
books/
*.epub
*.mobi
*.azw3
*.pdf

# Datasets, caches, model weights
data/
checkpoints/*
runs/
outputs/
*.safetensors
*.bin
*.pt
*.ckpt
.cache/
hf_cache/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/

# Local env / secrets — the example template IS tracked, the real key is not
.env
.env.*
!.env.example

# OS
Thumbs.db
desktop.ini
.DS_Store

# Throwaway venv for CPU-only tooling, kept separate from .venv
.venv-tools/

# Selected experiment records are retained for reproducibility.
# Other logs, adapters, optimizer states, and model weights stay local.
logs/*
!logs/whole-child-stair.log
!logs/whole-child-stair.jsonl
!logs/whole-child-no-toc.log
!logs/whole-child-no-toc.jsonl
!logs/whole-child-no-toc-Mistral-7B-Instruct-v0-2.log
!logs/eval-whole-child.log
!logs/chain.log
!checkpoints/whole-child-stair-Mistral-7B-Instruct-v0-2/
checkpoints/whole-child-stair-Mistral-7B-Instruct-v0-2/*
!checkpoints/whole-child-stair-Mistral-7B-Instruct-v0-2/history.json
!checkpoints/whole-child-stair-Mistral-7B-Instruct-v0-2/adapter_config.json
!checkpoints/whole-child-no-toc-Mistral-7B-Instruct-v0-2/
checkpoints/whole-child-no-toc-Mistral-7B-Instruct-v0-2/*
!checkpoints/whole-child-no-toc-Mistral-7B-Instruct-v0-2/history.json
!checkpoints/whole-child-no-toc-Mistral-7B-Instruct-v0-2/adapter_config.json

# Build artifacts
*.egg-info/
dist/
build/
.pytest_cache/

# Private working documents: not part of the public code repo.
# (git does not support trailing comments on a pattern line)
BLOG.md
HURDLES.md
CLAUDE.md
PROJECT.md
RESUME.md
blog/

# The manuscript and video are local only and must not enter release archives.
/main.tex
/main.pdf
/video/

# Local archive-building helper; not part of the reusable STAIR tools.
/scripts/package_reproducibility.py
